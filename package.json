{
  "name": "maatwerk",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:mock": "npm run dev:mock -w ui",
    "build:exe": "tauri build --no-bundle",
    "build:ui": "npm run build -w ui",
    "lint": "npm run lint -w ui && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w ui",
    "test": "npm run test -w ui && node --test \"tools/**/*.test.mjs\" \"tests/**/*.test.mjs\"",
    "test:e2e": "npm run test:e2e -w ui",
    "licenses": "node tools/check-npm-licenses.mjs",
    "golden:regen": "node tests/reference-harness/regen.mjs",
    "golden:check": "node tests/reference-harness/regen.mjs --check && node tests/reference-harness/typst/regen-typst.mjs --check",
    "golden:typst": "node tests/reference-harness/typst/regen-typst.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24"
  }
}
