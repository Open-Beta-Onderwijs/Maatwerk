{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatwerk.invalid/schemas/school.schema.json",
  "title": "school.json",
  "description": "data/school.json. Written by Store.saveSchool (blind write + lock). All fields optional.",
  "type": "object",
  "properties": {
    "naam": {
      "type": "string"
    },
    "ondertitel": {
      "type": "string"
    },
    "motto": {
      "type": "string"
    },
    "schoolsoort": {
      "type": "array",
      "items": {
        "enum": ["Vmbo-bb", "Vmbo-kb", "Vmbo-gl", "Vmbo-tl", "Havo", "Vwo", "Gymnasium"]
      }
    },
    "logo": {
      "type": "string",
      "description": "fotos/school-logo.<ext>"
    },
    "watermerk": {
      "type": "string",
      "description": "fotos/school-watermerk.<ext>"
    },
    "minAppVersion": {
      "type": "string",
      "description": "Older apps open read-only (PLAN-2 decision 5); 0.26.0 from step 35."
    },
    "secties": {
      "type": "object",
      "description": "Per vak key: the sectievoorzitter (step 7b) and the sectiesecretaris (step 35), user ids.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "voorzitter": { "type": ["string", "null"] },
          "secretaris": { "type": ["string", "null"] },
          "gast": {
            "type": "boolean",
            "description": "Step 36: the login list of the vak shows a Gast (reads, never writes)."
          }
        }
      }
    }
  }
}
