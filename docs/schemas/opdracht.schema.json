{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maatwerk.invalid/schemas/opdracht.schema.json",
  "title": "opdrachten/<opdrachtId>.json",
  "description": "Opdracht metadata; the Typst source is opdrachten/<typFile>. Written by Store.upsertOpdracht (CAS + rev + lock).",
  "type": "object",
  "required": ["id", "naam", "typFile"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[\\w-]+$",
      "description": "opdracht_<ms epoch>; must match ^[\\w-]+$ or the image handlers throw"
    },
    "naam": {
      "type": "string"
    },
    "beschrijving": {
      "type": "string"
    },
    "schoolsoort": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vakken": {
      "type": "array",
      "items": {
        "enum": ["nat", "bio", "schk", "wisob", "wisa", "wisb", "wisc", "wisd"]
      }
    },
    "jaarlagen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observaties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "observatie ids"
    },
    "typFile": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.typ$",
      "description": "bare file name in data/opdrachten/"
    },
    "_meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "description": "Version stamp written by stampMeta (store.js:90-102).",
      "required": ["rev", "createdBy", "createdAt", "updatedBy", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "createdBy": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updatedBy": {
          "type": ["string", "null"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
